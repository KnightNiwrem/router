{
    "name": "@grammyjs/router",
    "version": "2.0.0",
    "exports": "./src/mod.ts",
    "imports": {
        "@grammyjs/grammy": "jsr:@grammyjs/grammy@^2.0.0-beta.6"
    },
    "license": "MIT",
    "publish": {
        "include": [
            "LICENSE",
            "README.md",
            "src/**/*.ts"
        ]
    },
    "nodeModulesDir": "none",
    "lock": false,
    "tasks": {
        "check": "deno check --allow-import src/mod.ts",
        "test": "deno test --allow-import test",
        "ok": "deno fmt --check && deno lint && deno task check && deno task test",
        "pack": "deno pack",
        "pack:npm": "rm -rf out/npm && mkdir -p out/npm && deno pack --output out/npm.tgz && tar -xzf out/npm.tgz --directory out/npm --strip-components=1 && cp package.json out/npm/package.json && rm out/npm.tgz",
        "publish:jsr": "deno publish",
        "publish:jsr:dry-run": "deno publish --dry-run",
        "publish:npm": "deno task pack:npm && npm publish ./out/npm"
    },
    "fmt": {
        "indentWidth": 4,
        "proseWrap": "preserve"
    },
    "lint": {
        "rules": {
            "include": ["no-top-level-await"]
        }
    }
}
