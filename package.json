{
    "name": "@grammyjs/router",
    "description": "Router middleware for grammY",
    "version": "2.0.0",
    "author": "KnorpelSenf",
    "license": "MIT",
    "engines": {
        "node": ">=24.0.0"
    },
    "homepage": "https://grammy.dev/plugins/router.html",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/grammyjs/router.git"
    },
    "bugs": {
        "url": "https://github.com/grammyjs/router/issues"
    },
    "peerDependencies": {
        "@grammyjs/grammy": "npm:@jsr/grammyjs__grammy@^2.0.0-beta.6"
    },
    "files": [
        "src/"
    ],
    "main": "./src/mod.js",
    "types": "./src/mod.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/mod.d.ts",
            "import": "./src/mod.js",
            "require": "./src/mod.js",
            "default": "./src/mod.js"
        }
    },
    "keywords": [
        "router",
        "bot",
        "middleware",
        "grammy"
    ]
}
